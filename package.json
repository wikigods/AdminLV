{
  "name": "admin-lv",
  "description": "Responsive open source admin dashboard and control panel built with Bootstrap 5.",
  "version": "2.0.2",
  "license": "MIT",
  "author": "Colorlib <https://colorlib.com>",
  "main": "dist/js/adminlv.min.js",
  "scripts": {
    "bundlewatch": "bundlewatch --config .bundlewatch.config.json",
    "css": "npm-run-all css-compile css-prefix css-minify",
    "css-splits": "npm-run-all css-compile-splits css-prefix-splits css-minify-splits",
    "css-all": "npm-run-all css css-splits",
    "css-compile-bash": "sass --silence-deprecation=color-functions,global-builtin,import,if-function --load-path=node_modules --style=expanded --source-map --embed-sources ",
    "css-compile": "npm run css-compile-bash -- build/scss/adminlte.scss dist/css/adminlv.css",
    "css-compile-splits": "npm run css-compile-bash -- build/scss/parts:dist/css/alt/",
    "css-prefix": "node build/npm/PrefixCss.js dist/css",
    "css-prefix-splits": "node build/npm/PrefixCss.js dist/css/alt",
    "css-minify-bash": "cleancss -O1 --format breakWith=lf --with-rebase --source-map --source-map-inline-sources --output ",
    "css-minify": "npm run css-minify-bash -- dist/css/ --batch --batch-suffix \".min\" \"dist/css/*.css\" \"!dist/css/*.min.css\"",
    "css-minify-splits": "npm run css-minify-bash -- dist/css/alt/ --batch --batch-suffix \".min\" \"dist/css/alt/*.css\" \"!dist/css/alt/*.min.css\"",
    "css-lint": "stylelint \"build/scss/**/*.scss\" --cache --cache-location .cache/.stylelintcache",
    "compile": "npm-run-all js css-all",
    "dev": "npm-run-all --parallel watch sync",
    "docs": "npm-run-all docs-prepare docs-compile",
    "docs-lint": "node build/npm/vnu-jar.js",
    "docs-compile": "cd docs/ && bundle exec jekyll build -d ../docs_html",
    "docs-serve": "npm-run-all compile docs-prepare && cd docs/ && bundle exec jekyll serve",
    "docs-prepare": "node build/npm/DocsPublish.js -v",
    "lockfile-lint": "lockfile-lint --allowed-hosts npm --allowed-schemes https: --empty-hostname false --type npm --path package-lock.json",
    "postinstall": "npm run plugins",
    "js": "npm-run-all js-compile js-minify",
    "js-compile": "rollup --config build/config/rollup.config.js --sourcemap",
    "js-minify": "terser --compress typeofs=false --mangle --comments \"/^!/\" --source-map \"content=dist/js/adminlv.js.map,includeSources,url=adminlv.min.js.map\" --output dist/js/adminlv.min.js dist/js/adminlv.js",
    "js-lint": "eslint --cache --cache-location .cache/.eslintcache --report-unused-disable-directives .",
    "lint": "npm-run-all --continue-on-error --parallel css-lint js-lint lockfile-lint",
    "production": "npm-run-all compile plugins",
    "prepare-release": "npm-run-all production docs",
    "test": "npm-run-all lint production",
    "plugins": "node build/npm/Publish.js -v",
    "sync": "browser-sync start --server --files *.html pages/ dist/",
    "watch": "concurrently \"npm run watch-css\" \"npm run watch-js\"",
    "watch-css": "nodemon --legacy-watch --watch build/scss -e scss -x \"npm-run-all css-lint css\"",
    "watch-js": "nodemon --legacy-watch --watch build/js -e js -x \"npm-run-all js-lint js\""
  },
  "keywords": [
    "css",
    "sass",
    "responsive",
    "admin",
    "template",
    "theme",
    "framework",
    "control-panel",
    "dashboard"
  ],
  "homepage": "https://github.com/wikigods/AdminLV",
  "style": "dist/css/adminlv.css",
  "sass": "build/scss/adminlte.scss",
  "repository": {
    "type": "git",
    "url": "https://github.com/wikigods/AdminLV.git"
  },
  "bugs": {
    "url": "https://github.com/wikigods/AdminLV/issues"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@lgaitan/pace-progress": "^1.0.7",
    "@popperjs/core": "^2.11.8",
    "air-datepicker": "^3.6.0",
    "bootstrap": "^5.3.8",
    "bootstrap-slider": "^11.0.2",
    "bs-stepper": "^1.7.0",
    "bs5-lightbox": "^1.8.5",
    "chart.js": "^4.5.1",
    "codemirror": "^5.65.21",
    "datatables.net": "^3.1.3",
    "datatables.net-autofill-bs5": "^3.1.2",
    "datatables.net-bs5": "^3.1.3",
    "datatables.net-buttons-bs5": "^4.1.2",
    "datatables.net-colreorder-bs5": "^3.1.2",
    "datatables.net-fixedcolumns-bs5": "^6.1.1",
    "datatables.net-fixedheader-bs5": "^5.1.2",
    "datatables.net-keytable-bs5": "^3.1.1",
    "datatables.net-responsive-bs5": "^4.1.1",
    "datatables.net-rowgroup-bs5": "^2.1.1",
    "datatables.net-rowreorder-bs5": "^2.1.1",
    "datatables.net-scroller-bs5": "^3.1.1",
    "datatables.net-searchbuilder-bs5": "^2.1.1",
    "datatables.net-searchpanes-bs5": "^2.3.5",
    "datatables.net-select-bs5": "^4.1.1",
    "daterangepicker": "^3.1.0",
    "dropzone": "^6.3.5",
    "fastclick": "^1.0.6",
    "filterizr": "^2.2.4",
    "flag-icons": "^7.5.0",
    "flot": "^4.2.6",
    "fs-extra": "^11.4.1",
    "fullcalendar": "^5.11.5",
    "icheck-bootstrap": "^3.0.1",
    "inputmask": "^5.0.10",
    "ion-rangeslider": "^2.5.0",
    "jquery": "^3.7.1",
    "jquery-knob-chif": "^1.2.13",
    "jquery-mapael": "^2.2.0",
    "jquery-mousewheel": "^3.2.2",
    "jquery-ui-dist": "^1.13.3",
    "jquery-validation": "^1.22.1",
    "jqvmap-novulnerability": "^1.5.1",
    "jsgrid": "^1.5.3",
    "jszip": "^3.10.2",
    "moment": "^2.31.0",
    "overlayscrollbars": "^1.13.3",
    "pdfmake": "^0.3.11",
    "quill": "^2.0.3",
    "raphael": "^2.3.0",
    "select2": "^4.1.0",
    "select2-theme-bootstrap5": "^0.2.0",
    "sparklines": "^1.3.0",
    "summernote": "^0.9.1",
    "sweetalert2": "^11.26.25",
    "toastr": "^2.1.4",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@eslint/compat": "2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "autoprefixer": "^10.6.1",
    "browser-sync": "^3.0.4",
    "bundlewatch": "^0.4.2",
    "clean-css-cli": "^5.6.3",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-config-xo": "^0.41.0",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-import-x": "4.16.2",
    "eslint-plugin-unicorn": "^56.0.1",
    "globals": "^17.13.0",
    "lockfile-lint": "^5.1.0",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.29",
    "postcss-cli": "^12.0.0",
    "rollup": "^4.64.5",
    "sass": "^1.105.1",
    "stylelint": "^16.26.1",
    "stylelint-config-twbs-bootstrap": "^16.1.0",
    "terser": "^5.51.2",
    "vnu-jar": "^26.10.11"
  },
  "overrides": {
    "bundlewatch": {
      "axios": "^1.20.0"
    }
  }
}
